# unveil - one-file PE reverse-engineering pipeline
# MIT licensed. See LICENSE.

# Nothing from the toolchain or its downloads belongs in git.
# unveil fetches Ghidra and the JDK at runtime; they are hundreds of MB
# and carry their own licenses (see THIRD-PARTY-NOTICES.md).
work/
tools/
downloads/
*.zip
*.verified

# Default output root when run in-place.
out/
unveil-out/

# Ghidra writes these next to a project.
*.gpr
*.rep/
*.lock
*.lock~

# Built artifact. unveil-single.cmd embeds the whole engine (Ghidra + a jlink runtime)
# and is ~178 MB, so it cannot be committed: GitHub rejects any file over 100 MB.
# Build it with .\build.ps1, or download it from the GitHub Release.
unveil-single.cmd
*.tar.zst
*.tar.xz

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store